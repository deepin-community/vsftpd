diff --git a/sysdeputil.c b/sysdeputil.c
index f5640be..ca0fee0 100644
--- a/sysdeputil.c
+++ b/sysdeputil.c
@@ -1382,7 +1382,11 @@ vsf_sysutil_getpid_nocache(void)
